resource "oci_core_drg" "this" {
  for_each = local.drg

  compartment_id = each.value.compartment_id
  display_name   = each.value.display_name
  freeform_tags  = var.freeform_tags
}

# 사용자 정의 DRG route table (Autogenerated 두 개는 OCI 가 자동 생성 → 관리 대상 아님)
resource "oci_core_drg_route_table" "this" {
  for_each = local.drg_rt

  drg_id        = oci_core_drg.this[each.value.drg_key].id
  display_name  = each.value.display_name
  freeform_tags = var.freeform_tags
}

locals {
  # 이 stack 에서 만든 것 + 다른 stack(hub)에서 받은 것
  drg_ids    = merge(var.external_drg_ids, { for k, d in oci_core_drg.this : k => d.id })
  drg_rt_ids = merge(var.external_drg_route_table_ids, { for k, r in oci_core_drg_route_table.this : k => r.id })
}

resource "oci_core_drg_attachment" "this" {
  for_each = local.drga

  drg_id             = lookup(local.drg_ids, each.value.drg_key, null)
  display_name       = each.key
  drg_route_table_id = each.value.drg_route_table == null ? null : lookup(local.drg_rt_ids, each.value.drg_route_table, null)
  freeform_tags      = var.freeform_tags

  network_details {
    id             = oci_core_vcn.this[each.value.vcn_key].id
    type           = "VCN"
    route_table_id = each.value.route_table == null ? null : lookup(local.rt_drga_ids, each.value.route_table, null)
  }
}

locals {
  drga_ids = { for k, a in oci_core_drg_attachment.this : k => a.id }
}

# DRG route table 의 static rule (next_hop = 같은 stack 의 DRG attachment)
resource "oci_core_drg_route_table_route_rule" "this" {
  for_each = local.drg_rt_rules

  drg_route_table_id         = lookup(local.drg_rt_ids, each.value.rt_key, null)
  destination                = each.value.destination
  destination_type           = "CIDR_BLOCK"
  next_hop_drg_attachment_id = lookup(local.drga_ids, each.value.next_hop, null)
}
