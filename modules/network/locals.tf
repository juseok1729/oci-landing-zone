#
# YAML(var.vcns, var.drgs)을 리소스별 평평한 map 으로 정리한다.
#  - 이름(키)은 전체에서 유일 → 리소스 for_each 키로 그대로 사용
#  - compartment 는 이름이면 OCID 로 바꾸고, ocid1... 이면 그대로 사용
#  - 여기서는 리소스를 참조하지 않는다 (설정 값만 다룸)
#  - 이름이 중복되면 merge 가 덮어쓰고, validation.tf 의 중복 검사가 메시지로 알린다
#

locals {
  # ── VCN ────────────────────────────────────────────────────
  vcn = {
    for vk, v in var.vcns : vk => {
      display_name               = coalesce(v.display_name, vk)
      compartment_id             = lookup(var.compartment_ids, v.compartment, v.compartment)
      cidrs                      = v.cidrs
      dns_label                  = v.dns_label
      lock_default_security_list = v.lock_default_security_list
      drg_key                    = try(v.drg_attachment.drg, null)
    }
  }

  # ── Internet Gateway ───────────────────────────────────────
  igw = merge([
    for vk, v in var.vcns : {
      for gk, g in v.internet_gateways : gk => {
        vcn_key        = vk
        display_name   = coalesce(g.display_name, gk)
        compartment_id = lookup(var.compartment_ids, coalesce(g.compartment, v.compartment), coalesce(g.compartment, v.compartment))
        enabled        = g.enabled
      }
    }
  ]...)

  # ── Service Gateway ────────────────────────────────────────
  sgw = merge([
    for vk, v in var.vcns : {
      for gk, g in v.service_gateways : gk => {
        vcn_key        = vk
        display_name   = coalesce(g.display_name, gk)
        compartment_id = lookup(var.compartment_ids, coalesce(g.compartment, v.compartment), coalesce(g.compartment, v.compartment))
        services       = g.services
        route_table    = try(g.route_table.name, null)
      }
    }
  ]...)

  # ── DRG attachment (키 = attachment 이름) ───────────────────
  drga = merge([
    for vk, v in var.vcns : {
      (v.drg_attachment.name) = {
        vcn_key     = vk
        drg_key     = v.drg_attachment.drg
        route_table = try(v.drg_attachment.route_table.name, null)
        drg_route_table = (
          contains(["autogenerated", "default"], coalesce(v.drg_attachment.drg_route_table, "default"))
          ? null
          : v.drg_attachment.drg_route_table
        )
      }
    } if v.drg_attachment != null
  ]...)

  # ── Subnet ─────────────────────────────────────────────────
  subnet = merge([
    for vk, v in var.vcns : {
      for sk, s in v.subnets : sk => {
        vcn_key        = vk
        display_name   = coalesce(s.display_name, sk)
        compartment_id = lookup(var.compartment_ids, coalesce(s.compartment, v.compartment), coalesce(s.compartment, v.compartment))
        cidr           = s.cidr
        public         = s.public
        dns_label      = s.dns_label
        route_table    = s.route_table == "default" ? null : s.route_table
        security_lists = s.security_lists
      }
    }
  ]...)

  # ── Route table ────────────────────────────────────────────
  # YAML 에 적힌 위치가 곧 종류(kind) → Terraform 리소스 블록이 정해진다.
  #   subnet : route_tables:                           (oci_core_route_table.subnet)
  #   sgw    : service_gateways.<SGW>.route_table:     (oci_core_route_table.sgw)
  #   drga   : drg_attachment.route_table:             (oci_core_route_table.drga)
  # 세 블록으로 나누는 이유는 Terraform 순환 의존 방지 (route_tables.tf 상단 주석).
  rt_raw = flatten([
    for vk, v in var.vcns : concat(
      [for rk, r in v.route_tables : { key = rk, vcn_key = vk, kind = "subnet", vcn_cmp = v.compartment, display_name = r.display_name, compartment = r.compartment, rules = r.rules }],
      [for g in v.service_gateways : { key = g.route_table.name, vcn_key = vk, kind = "sgw", vcn_cmp = v.compartment, display_name = g.route_table.display_name, compartment = g.route_table.compartment, rules = g.route_table.rules } if g.route_table != null],
      try([{ key = v.drg_attachment.route_table.name, vcn_key = vk, kind = "drga", vcn_cmp = v.compartment, display_name = v.drg_attachment.route_table.display_name, compartment = v.drg_attachment.route_table.compartment, rules = v.drg_attachment.route_table.rules }], [])
    )
  ])

  # rule 은 destination 1개 = OCI rule 1개로 펼침.  spokes 는 spoke VCN CIDR 들로 (자기 VCN CIDR 은 뺀다)
  rt_all = merge([
    for r in local.rt_raw : {
      (r.key) = {
        vcn_key        = r.vcn_key
        kind           = r.kind
        display_name   = coalesce(r.display_name, r.key)
        compartment_id = lookup(var.compartment_ids, coalesce(r.compartment, r.vcn_cmp), coalesce(r.compartment, r.vcn_cmp))
        rules = flatten([
          for rule in r.rules : [
            for d in flatten([
              for x in concat(rule.destination == null ? [] : [rule.destination], rule.destinations) :
              x == "spokes" ? [for c in var.spoke_cidrs : c if !contains(local.vcn[r.vcn_key].cidrs, c)] : [x]
              ]) : {
              destination = d
              target      = rule.target
              description = rule.description
            }
          ] if rule.enabled
        ])
      }
    }
  ]...)

  rt_sgw    = { for k, r in local.rt_all : k => r if r.kind == "sgw" }
  rt_drga   = { for k, r in local.rt_all : k => r if r.kind == "drga" }
  rt_subnet = { for k, r in local.rt_all : k => r if r.kind == "subnet" }

  # ── privateip:<IP> target → 같은 VCN 안에서 그 IP 를 품은 subnet 찾기 ──
  pip_refs = distinct(flatten([
    for r in local.rt_all : [
      for rule in r.rules : "${trimprefix(rule.target, "privateip:")}@${r.vcn_key}"
      if startswith(rule.target, "privateip:")
    ]
  ]))

  pip_subnet_candidates = {
    for ref in local.pip_refs : ref => [
      for sk, s in local.subnet : sk
      if s.vcn_key == split("@", ref)[1] && try(
        cidrhost("${split("@", ref)[0]}/${split("/", s.cidr)[1]}", 0) == cidrhost(s.cidr, 0),
        false
      )
    ]
  }

  pip = {
    for ref, cands in local.pip_subnet_candidates : ref => {
      ip         = split("@", ref)[0]
      vcn_key    = split("@", ref)[1]
      subnet_key = length(cands) == 1 ? cands[0] : null
    }
  }

  # ── Security list / NSG ────────────────────────────────────
  protocol_numbers = { all = "all", tcp = "6", udp = "17", icmp = "1" }

  # SL 과 NSG 의 규칙은 형식이 같아서 한 번에 정규화한다.
  fw_owner = merge(flatten([
    for vk, v in var.vcns : [
      [for k, x in v.security_lists : { (k) = { owner_kind = "sl", vcn_key = vk, vcn_cmp = v.compartment, display_name = x.display_name, compartment = x.compartment, ingress = x.ingress, egress = x.egress } }],
      [for k, x in v.network_security_groups : { (k) = { owner_kind = "nsg", vcn_key = vk, vcn_cmp = v.compartment, display_name = x.display_name, compartment = x.compartment, ingress = x.ingress, egress = x.egress } }]
    ]
  ])...)

  fw_rules = flatten([
    for ok, o in local.fw_owner : [
      for dir in ["ingress", "egress"] : [
        for i, r in o[dir] : {
          id          = "${ok}|${dir}|${i}"
          owner       = ok
          owner_kind  = o.owner_kind
          dir         = dir
          where       = "${o.owner_kind == "sl" ? "security list" : "NSG"} ${ok} ${dir}[${i}]"
          cidr        = dir == "ingress" ? try(r.source, null) : try(r.destination, null)
          kind        = lower(r.protocol)
          protocol    = lookup(local.protocol_numbers, lower(r.protocol), r.protocol)
          port        = r.port
          port_min    = r.port == null ? null : try(tonumber(split("-", r.port)[0]), null)
          port_max    = r.port == null ? null : try(tonumber(reverse(split("-", r.port))[0]), null)
          sport       = r.source_port
          sport_min   = r.source_port == null ? null : try(tonumber(split("-", r.source_port)[0]), null)
          sport_max   = r.source_port == null ? null : try(tonumber(reverse(split("-", r.source_port))[0]), null)
          icmp_type   = r.icmp_type
          icmp_code   = r.icmp_code
          stateless   = r.stateless
          description = r.description
        }
      ]
    ]
  ])

  fw_common = {
    for ok, o in local.fw_owner : ok => {
      vcn_key        = o.vcn_key
      display_name   = coalesce(o.display_name, ok)
      compartment_id = lookup(var.compartment_ids, coalesce(o.compartment, o.vcn_cmp), coalesce(o.compartment, o.vcn_cmp))
    }
  }

  sl = {
    for ok, o in local.fw_owner : ok => merge(local.fw_common[ok], {
      ingress = [for r in local.fw_rules : r if r.owner == ok && r.dir == "ingress"]
      egress  = [for r in local.fw_rules : r if r.owner == ok && r.dir == "egress"]
    }) if o.owner_kind == "sl"
  }

  nsg       = { for ok, o in local.fw_owner : ok => local.fw_common[ok] if o.owner_kind == "nsg" }
  nsg_rules = { for r in local.fw_rules : r.id => r if r.owner_kind == "nsg" }

  # ── DRG ────────────────────────────────────────────────────
  drg = {
    for dk, d in var.drgs : dk => {
      display_name   = coalesce(d.display_name, dk)
      compartment_id = lookup(var.compartment_ids, d.compartment, d.compartment)
    }
  }

  drg_rt = merge([
    for dk, d in var.drgs : {
      for rk, r in d.route_tables : rk => {
        drg_key      = dk
        display_name = coalesce(r.display_name, rk)
      }
    }
  ]...)

  drg_rt_rules = merge(flatten([
    for dk, d in var.drgs : [
      for rk, r in d.route_tables : [
        for rule in r.rules : {
          for dest in flatten([
            for x in concat(rule.destination == null ? [] : [rule.destination], rule.destinations) :
            x == "spokes" ? var.spoke_cidrs : [x]
          ]) :
          "${rk}|${dest}" => {
            rt_key      = rk
            drg_key     = dk
            destination = dest
            next_hop    = rule.next_hop
          }
        } if rule.enabled
      ]
    ]
  ])...)
}
