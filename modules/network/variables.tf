#
# 입력 타입 = YAML 스키마.  optional(...) 의 두 번째 값이 기본값이다.
# 키를 추가/삭제하면 modules/config/main.tf 의 allowed 목록도 같이 고친다.
#

variable "compartment_ids" {
  description = "compartment 이름 → OCID"
  type        = map(string)
}

variable "freeform_tags" {
  description = "모든 리소스에 붙일 태그"
  type        = map(string)
  default     = {}
}

variable "external_drg_ids" {
  description = "다른 stack 이 만든 DRG (이름 → OCID). spoke stack 이 hub 의 DRG 에 attach 할 때 사용"
  type        = map(string)
  default     = {}
}

variable "external_drg_route_table_ids" {
  description = "다른 stack 이 만든 DRG route table (이름 → OCID)"
  type        = map(string)
  default     = {}
}

variable "spoke_cidrs" {
  description = "spoke VCN CIDR 전체 (config/vcns 의 hub 외 파일). route rule destination 의 spokes 를 이 목록으로 펼친다"
  type        = list(string)
  default     = []
  nullable    = false
}

variable "vcns" {
  description = "config/vcns/<파일>.yaml 내용 (키 = VCN 이름)"
  default     = {}
  nullable    = false

  type = map(object({
    compartment                = string
    cidrs                      = list(string)
    display_name               = optional(string)
    dns_label                  = optional(string)
    lock_default_security_list = optional(bool, false)

    internet_gateways = optional(map(object({
      display_name = optional(string)
      compartment  = optional(string)
      enabled      = optional(bool, true)
    })), {})

    service_gateways = optional(map(object({
      display_name = optional(string)
      compartment  = optional(string)
      services     = optional(string, "all-services") # all-services | objectstorage
      # SGW 전용 route table (target: drg / privateip)
      route_table = optional(object({
        name         = string
        display_name = optional(string)
        compartment  = optional(string)
        rules = optional(list(object({
          destination  = optional(string)
          destinations = optional(list(string), [])
          target       = string
          description  = optional(string)
          enabled      = optional(string, "true") # true | false | auto (privateip target 이 있을 때만)
        })), [])
      }))
    })), {})

    drg_attachment = optional(object({
      name            = string
      drg             = string
      drg_route_table = optional(string) # null/autogenerated = DRG 기본 테이블
      # VCN ingress 전용 route table (target: sgw / privateip)
      route_table = optional(object({
        name         = string
        display_name = optional(string)
        compartment  = optional(string)
        rules = optional(list(object({
          destination  = optional(string)
          destinations = optional(list(string), [])
          target       = string
          description  = optional(string)
          enabled      = optional(string, "true") # true | false | auto (privateip target 이 있을 때만)
        })), [])
      }))
    }))

    # subnet 용 route table
    route_tables = optional(map(object({
      display_name = optional(string)
      compartment  = optional(string)
      rules = optional(list(object({
        destination  = optional(string)
        destinations = optional(list(string), [])
        target       = string
        description  = optional(string)
        enabled      = optional(string, "true") # true | false | auto (privateip target 이 있을 때만)
      })), [])
    })), {})

    security_lists = optional(map(object({
      display_name = optional(string)
      compartment  = optional(string)
      ingress = optional(list(object({
        source      = string
        protocol    = optional(string, "all") # all | tcp | udp | icmp
        port        = optional(string)        # destination port: "443" 또는 "8000-8080"
        source_port = optional(string)        # source port: 형식 동일
        icmp_type   = optional(number)
        icmp_code   = optional(number)
        stateless   = optional(bool, false)
        description = optional(string)
      })), [])
      egress = optional(list(object({
        destination = string
        protocol    = optional(string, "all")
        port        = optional(string)
        source_port = optional(string)
        icmp_type   = optional(number)
        icmp_code   = optional(number)
        stateless   = optional(bool, false)
        description = optional(string)
      })), [])
    })), {})

    # NSG 는 만들기만 하고 OCID 를 출력한다. VNIC 연결은 인스턴스/LB 배포 쪽에서.
    # source / destination 에 nsg:<같은 VCN 의 NSG 이름> 도 가능
    network_security_groups = optional(map(object({
      display_name = optional(string)
      compartment  = optional(string)
      ingress = optional(list(object({
        source      = string
        protocol    = optional(string, "all")
        port        = optional(string)
        source_port = optional(string)
        icmp_type   = optional(number)
        icmp_code   = optional(number)
        stateless   = optional(bool, false)
        description = optional(string)
      })), [])
      egress = optional(list(object({
        destination = string
        protocol    = optional(string, "all")
        port        = optional(string)
        source_port = optional(string)
        icmp_type   = optional(number)
        icmp_code   = optional(number)
        stateless   = optional(bool, false)
        description = optional(string)
      })), [])
    })), {})

    subnets = optional(map(object({
      cidr           = string
      display_name   = optional(string)
      compartment    = optional(string)
      public         = optional(bool, false)
      route_table    = optional(string) # null/default = VCN 기본 route table
      security_lists = optional(list(string), [])
      dns_label      = optional(string)
    })), {})
  }))
}

variable "drgs" {
  description = "config/drg.yaml 의 drgs (키 = DRG 이름). hub stack 만 넘깁니다"
  default     = {}
  nullable    = false

  type = map(object({
    compartment  = string
    display_name = optional(string)
    route_tables = optional(map(object({
      display_name = optional(string)
      rules = optional(list(object({
        destination  = optional(string)
        destinations = optional(list(string), [])
        next_hop     = string # DRG attachment 이름
        enabled      = optional(bool, true)
      })), [])
    })), {})
  }))
}
